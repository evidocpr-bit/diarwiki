[Unit]
Description=Remove expired DiarWiki previews

[Service]
Type=oneshot
User=diarwiki-preview
Group=diarwiki-preview
WorkingDirectory=/opt/diarwiki/current
EnvironmentFile=/etc/diarwiki/preview.env
ExecStart=/usr/bin/node /opt/diarwiki/current/cms/preview/cleanup-previews.mjs /srv/diarwiki-previews
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/diarwiki-previews
UMask=0027
