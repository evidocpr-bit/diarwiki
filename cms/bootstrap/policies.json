        { "collection": "releases", "action": "create", "fields": ["release_id", "request", "status", "source_commit", "snapshot_id", "snapshot_sha256", "archive_sha256", "previous_release_id", "routes", "material_versions", "built_at", "activated_at", "verification_result"], "permissions": {} }
      ]
    }
  ]
}
