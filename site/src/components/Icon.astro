---
interface Props { name: string; size?: number; class?: string; }
const { name, size = 40, class: className = '' } = Astro.props;
const small = ['search', 'menu', 'telegram', 'mail', 'up'].includes(name);
const paths: Record<string, string[]> = {
  document: ['M8 34V8h18l6 6v20z', 'M26 8v6h6', 'M13 20h14', 'M13 25h14', 'M13 30h8'],
  sensor: ['M20 30v8'],
  book: ['M6 10c5-2 10-2 14 2v22c-4-4-9-4-14-2z', 'M34 10c-5-2-10-2-14 2v22c4-4 9-4 14-2z'],
  people: ['M5 33c0-6 4-10 9-10s9 4 9 10', 'M24 24c5-1 10 2 10 9'],
  convert: ['M6 14h26l-6-6', 'M34 26H8l6 6'],
  link: ['M17 23a6 6 0 0 0 9 0l5-5a6 6 0 0 0-9-9l-2 2', 'M23 17a6 6 0 0 0-9 0l-5 5a6 6 0 0 0 9 9l2-2'],
  'check-doc': ['M9 34V6h16l6 6v22z', 'M14 22l4 4 8-9'],
  shield: ['M20 4 6 9v10c0 9 6 14 14 17 8-3 14-8 14-17V9z', 'M14 20h12'],
  search: ['M10.8 17.6a6.8 6.8 0 1 0 0-13.6a6.8 6.8 0 1 0 0 13.6', 'm16 16 5 5'],
  menu: ['M4 8h16', 'M4 16h16'],
  telegram: ['M21 4 3 11l6 2 2 6 3-4 5 4z', 'm9 13 8-6'],
  mail: ['M3 5h18v14H3z', 'm3 6 9 7 9-7'],
  up: ['M12 20V4', 'M5 11l7-7 7 7'],
};
const pathList = paths[name] ?? [];
const circles: Record<string, Array<{ cx: number; cy: number; r: number }>> = {
  sensor: [{ cx: 20, cy: 18, r: 12 }, { cx: 20, cy: 18, r: 4 }],
  people: [{ cx: 14, cy: 13, r: 5 }, { cx: 27, cy: 15, r: 4 }],
};
const circleList = circles[name] ?? [];
---
<svg class:list={['ico', className]} width={size} height={size} viewBox={small ? '0 0 24 24' : '0 0 40 40'} fill="none" stroke="currentColor" stroke-width={small ? (['telegram', 'mail', 'up'].includes(name) ? '1.4' : '1.6') : '1.5'} aria-hidden="true">
  {pathList.map((d) => <path pathLength="1" d={d} />)}
  {circleList.map((circle) => <circle pathLength="1" cx={circle.cx} cy={circle.cy} r={circle.r} />)}
</svg>
