---
import { getTelegramCategoryCounts, getTelegramCommunities, telegramCategoryOrder } from '../../lib/telegramCommunities';

const communities = getTelegramCommunities();
const counts = getTelegramCategoryCounts();
const categorySlug = (category: string) => `telegram-${telegramCategoryOrder.indexOf(category as typeof telegramCategoryOrder[number]) + 1}`;
const searchText = (item: (typeof communities)[number]) => [item.name, item.category, item.audience, item.region, item.description, item.editorialNote]
  .join(' ')
  .toLocaleLowerCase('ru');
---

<section class="community-directory" data-community-directory>
  <header class="community-directory__head">
    <span>[ Реестр · 28.10.2026 ]</span>
    <strong>{communities.length} ресурсов · {telegramCategoryOrder.length} разделов</strong>
  </header>

  <div class="community-directory__tools">
    <label>
      <span>Поиск по названию, теме или региону</span>
      <input type="search" placeholder="Например: Libre, беременность или Хабаровск" data-community-search />
    </label>
    <p aria-live="polite" data-community-count>{communities.length} из {communities.length}</p>
  </div>

  <nav class="community-directory__nav" aria-label="Разделы каталога">
    <button type="button" aria-pressed="true" data-category-filter="all">Все <span>{communities.length}</span></button>
    {counts.map(({ category, count }) => (
      <button type="button" aria-pressed="false" data-category-filter={category}>{category} <span>{count}</span></button>
    ))}
  </nav>

  <div class="community-directory__empty" hidden data-community-empty>
    Ничего не нашлось. Попробуйте название устройства, город или более короткий запрос.
  </div>

  {telegramCategoryOrder.map((category) => {
    const items = communities.filter((item) => item.category === category);
    return (
      <section class="community-group" data-community-group={category} aria-labelledby={categorySlug(category)}>
        <div class="community-group__title">
          <h3 id={categorySlug(category)}>{category}</h3>
          <span>{items.length}</span>
        </div>
        <div class="community-grid">
          {items.map((item) => (
            <article class="community-card" data-community-card data-category={item.category} data-search={searchText(item)}>
              <div class="community-card__meta">
                <span>{item.id}</span>
                <span>{item.region === 'не указан' ? 'регион не указан' : item.region}</span>
              </div>
              <h4>{item.name}</h4>
              <p class="community-card__audience">Для кого: {item.audience}</p>
              <p>{item.description}</p>
              <div class="community-card__note">
                <strong>Комментарий редакции</strong>
                <p>{item.editorialNote}</p>
              </div>
              {item.canLink ? (
                <a href={item.url} target="_blank" rel="noopener noreferrer">Открыть в Telegram <span aria-hidden="true">↗</span></a>
              ) : (
                <span class="community-card__closed">Вход через модератора · ссылка скрыта до согласования</span>
              )}
            </article>
          ))}
        </div>
      </section>
    );
  })}
</section>

<script>
  const normalize = (value: string) => value.toLocaleLowerCase('ru').trim();
  document.querySelectorAll<HTMLElement>('[data-community-directory]').forEach((directory) => {
    const input = directory.querySelector<HTMLInputElement>('[data-community-search]');
    const cards = Array.from(directory.querySelectorAll<HTMLElement>('[data-community-card]'));
    const groups = Array.from(directory.querySelectorAll<HTMLElement>('[data-community-group]'));
    const filters = Array.from(directory.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
    const counter = directory.querySelector<HTMLElement>('[data-community-count]');
    const empty = directory.querySelector<HTMLElement>('[data-community-empty]');
    let activeCategory = 'all';

    const apply = () => {
      const query = normalize(input?.value ?? '');
      let visible = 0;
      cards.forEach((card) => {
        const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const matchesQuery = !query || normalize(card.dataset.search ?? '').includes(query);
        card.hidden = !(matchesCategory && matchesQuery);
        if (!card.hidden) visible += 1;
      });
      groups.forEach((group) => {
        group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('[data-community-card]')).some((card) => !card.hidden);
      });
      if (counter) counter.textContent = `${visible} из ${cards.length}`;
      if (empty) empty.hidden = visible !== 0;
    };

    input?.addEventListener('input', apply);
    filters.forEach((button) => button.addEventListener('click', () => {
      activeCategory = button.dataset.categoryFilter ?? 'all';
      filters.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      apply();
    }));
  });
</script>

<style>
  .community-directory{display:flex;flex-direction:column;gap:32px}.community-directory__head{display:flex;justify-content:space-between;gap:16px;padding:12px 16px;border:1px solid var(--dw-blue);background:var(--dw-blue);color:#fff;font:400 11px/1.4 var(--dw-font-mono);letter-spacing:.12em;text-transform:uppercase}.community-directory__tools{display:flex;align-items:end;justify-content:space-between;gap:24px}.community-directory__tools label{flex:1;display:flex;flex-direction:column;gap:8px;color:var(--dw-blue);font:400 11px/1.4 var(--dw-font-mono);letter-spacing:.1em;text-transform:uppercase}.community-directory__tools input{width:100%;min-height:48px;padding:8px 0;border:0;border-bottom:1px solid var(--dw-blue);border-radius:0;background:transparent;color:var(--dw-ink);font:400 16px/1.4 var(--dw-font-text)}.community-directory__tools p{margin:0;color:var(--dw-muted);font:400 12px/1.4 var(--dw-font-mono);white-space:nowrap}.community-directory__nav{display:flex;flex-wrap:wrap;border-top:1px solid var(--dw-blue);border-left:1px solid var(--dw-blue)}.community-directory__nav button{min-height:42px;padding:8px 12px;border:0;border-right:1px solid var(--dw-blue);border-bottom:1px solid var(--dw-blue);background:transparent;color:var(--dw-blue);font:400 11px/1.3 var(--dw-font-mono);letter-spacing:.06em;text-transform:uppercase;cursor:pointer}.community-directory__nav button span{opacity:.65}.community-directory__nav button[aria-pressed="true"],.community-directory__nav button:hover,.community-directory__nav button:focus-visible{background:var(--dw-blue);color:#fff}.community-directory__empty{padding:20px;border:1px dashed var(--dw-blue);color:var(--dw-muted)}.community-group{display:flex;flex-direction:column;gap:0}.community-group__title{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:0 0 12px;border-bottom:1px solid var(--dw-blue)}.community-group__title h3{margin:0!important;font:600 26px/1.1 var(--dw-font-display)!important}.community-group__title span{color:var(--dw-blue);font:400 18px/1 var(--dw-font-mono)}.community-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-left:1px solid var(--dw-blue)}.community-card{min-width:0;padding:22px;border-right:1px solid var(--dw-blue);border-bottom:1px solid var(--dw-blue);display:flex;flex-direction:column;gap:14px}.community-card[hidden],.community-group[hidden]{display:none}.community-card__meta{display:flex;justify-content:space-between;gap:12px;color:var(--dw-muted);font:400 10px/1.4 var(--dw-font-mono);letter-spacing:.08em;text-transform:uppercase}.community-card h4{margin:0;color:var(--dw-blue);font:600 22px/1.12 var(--dw-font-display);letter-spacing:-.015em}.community-card p{margin:0!important;font-size:15px;line-height:1.5}.community-card__audience{color:var(--dw-muted)}.community-card__note{margin-top:auto;padding-top:14px;border-top:1px dashed var(--dw-line)}.community-card__note strong{display:block;margin-bottom:6px;color:var(--dw-blue);font:400 10px/1.4 var(--dw-font-mono);letter-spacing:.1em;text-transform:uppercase}.community-card__note p{color:var(--dw-muted);font-size:14px}.community-card>a{align-self:flex-start;color:var(--dw-blue);font:600 13px/1.4 var(--dw-font-text);text-underline-offset:.2em}.community-card__closed{color:var(--dw-muted);font:400 12px/1.5 var(--dw-font-mono)}
  @media(max-width:680px){.community-directory__head,.community-directory__tools{align-items:stretch;flex-direction:column}.community-grid{grid-template-columns:1fr}.community-card{padding:20px 16px}.community-card__meta{align-items:flex-start;flex-direction:column;gap:4px}}
</style>
