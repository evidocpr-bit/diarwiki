---
import TextPageLayout from '../layouts/TextPageLayout.astro';
import { siteIdentity } from '../config/site';
const email = import.meta.env.PUBLIC_EDITOR_EMAIL || siteIdentity.editorEmail;
const { owner } = siteIdentity;
---
<TextPageLayout title="Связаться с редакцией" description="Сообщить о неточности, неработающей ссылке или предложить тему." eyebrow="Контакт" updated="22 октября 2026 года">
  {email ? (
    <>
      <h2>Нашли неточность?</h2>
      <p>Напишите на <a href={`mailto:${email}?subject=${encodeURIComponent('ДиарВики: сообщение о неточности')}`}>{email}</a>. Укажите адрес страницы, спорный фрагмент и, если возможно, ссылку на источник.</p>
    </>
  ) : (
    <div class="notice"><strong>Контакт редакции настраивается.</strong> Эта кандидатная версия ещё не открыта для индексации. Рабочий адрес будет добавлен до публичного выпуска.</div>
  )}
  <h2>Владелец сайта</h2>
  <p>Владелец сайта — {owner.name}, {owner.status}. Место нахождения: {owner.location}. Адрес <a href={`mailto:${email}`}>{email}</a> используется для связи с редакцией, вопросов об обработке данных и обращений о возможном нарушении прав.</p>
  <h2>Не отправляйте медицинские данные</h2>
  <p>Не присылайте анализы, назначения, номера документов, фотографии медицинских записей, точные показатели или данные третьих лиц. Редакция не отвечает на индивидуальные медицинские вопросы и не оказывает экстренную помощь.</p>
  <h2>Если нужна медицинская помощь</h2>
  <p>Обратитесь к своей медицинской команде. При угрозе жизни звоните 112.</p>
</TextPageLayout>
